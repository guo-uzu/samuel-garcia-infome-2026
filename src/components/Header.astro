---
import { siteConfig } from "../config/site";
import logo from "../assets/nl-logo-white.svg";
import SiteMenu from "./SiteMenu.astro";
---

<header class="site-header">
    <div class="container site-header__inner">
        <a
            class="site-header__brand"
            href="/"
            aria-label={`${siteConfig.title} — Ir al inicio`}
        >
            <img
                class="site-header__logo"
                src={logo.src}
                alt=""
                width={logo.width}
                height={logo.height}
                decoding="async"
            />
        </a>
        <SiteMenu links={siteConfig.nav} />
    </div>
</header>
---
import samuelGarcia from "../assets/samuelGarcia.webp";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { siteConfig } from "../config/site";
---

<section class="hero" aria-labelledby="hero-etiqueta">
    <YouTube
        class="hero__youtube"
        poster={siteConfig.video.poster ?? ""}
        posterQuality="high"
        id={siteConfig.video.url}
        params="controls=1&rel=0&playsinline=1"
    />
</section>

<section class="intro" aria-label="Mensaje institucional">
    <div class="container">
        <div class="intro__card">
            <div class="intro__portrait">
                <img
                    src={samuelGarcia.src}
                    alt="Samuel García"
                    width={samuelGarcia.width}
                    height={samuelGarcia.height}
                    loading="lazy"
                    decoding="async"
                />
            </div>

            <div class="intro__copy">
                <p>
                    Hace un año{" "}
                    <strong>
                        te dije que íbamos en tiempo y forma, hoy te demuestro
                        que lo nuevo sí cumple!
                    </strong>
                </p>
                <p>
                    Millones de neoleoneses ya se benefician de las{" "}
                    <strong>obras que construimos por todo el estado,</strong>{" "}
                    como el Nuevo Cuartel General, la Nueva Presa León, nuevas
                    escuelas, nuevos parques y estamos muy cerca de movernos en
                    las nuevas Líneas del Metro.
                </p>
                <p>
                    <strong>
                        Terminamos lo que otros gobiernos ni siquiera empezaron
                        y sin endeudar al estado.
                    </strong>{" "}
                    Gracias a ello, Nuevo León tiene los mejores resultados de
                    seguridad de los últimos 20 años, una reducción histórica de
                    la pobreza y seguimos siendo los primeros en economía y
                    coberturas de salud gratuitas.
                </p>
                <p>
                    Hace cinco años nos diste tu confianza y no te equivocaste,{" "}
                    <strong>
                        valió la pena confiar en lo nuevo, porque lo nuevo sí
                        cumple.
                    </strong>
                </p>
            </div>
        </div>
    </div>
</section>

<script>
    interface YouTubePlayer {
        mute(): void;
        playVideo(): void;
    }

    interface LiteYouTubeElement extends HTMLElement {
        getYTPlayer(): Promise<YouTubePlayer>;
    }

    async function autoplayHeroVideo() {
        // Wait until <lite-youtube> has been registered
        await customElements.whenDefined("lite-youtube");

        const youtube =
            document.querySelector<LiteYouTubeElement>(".hero__youtube");

        if (!youtube) return;

        // Prevent initializing it twice
        if (youtube.dataset.autoplayInitialized === "true") return;

        youtube.dataset.autoplayInitialized = "true";

        try {
            // getYTPlayer() also activates/loads the real YouTube iframe
            const player = await youtube.getYTPlayer();

            // Autoplay is normally blocked unless the video is muted
            player.playVideo();
        } catch (error) {
            console.error("Could not autoplay hero video:", error);

            // Allow retry if Astro navigates/re-renders
            youtube.dataset.autoplayInitialized = "false";
        }
    }

    // Normal page load
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", autoplayHeroVideo, {
            once: true,
        });
    } else {
        autoplayHeroVideo();
    }

    // Also works if you're using Astro View Transitions / ClientRouter
    document.addEventListener("astro:page-load", autoplayHeroVideo);
</script>

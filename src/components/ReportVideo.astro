---
import { siteConfig } from "../config/site";

const { videosIndividualPage } = siteConfig;

const sectionName = Astro.url.pathname.split("/").filter(Boolean).at(-1);

type IndividualVideo = {
    status: "ready" | "coming-soon";
    url: string | null;
    poster: string | null;
    urlMobile: string | null;
};

const video =
    sectionName && sectionName in videosIndividualPage
        ? (videosIndividualPage[
              sectionName as keyof typeof videosIndividualPage
          ] as IndividualVideo)
        : null;

const shouldShowVideo = video?.status === "ready";

function getYouTubeId(value: string | null | undefined) {
    if (!value) return null;
    if (/^[A-Za-z0-9_-]{11}$/.test(value)) return value;

    return (
        value.match(
            /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/,
        )?.[1] ?? null
    );
}

const videoId = getYouTubeId(video?.url);
const autoplayUrl = videoId
    ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&playsinline=1&rel=0`
    : null;
---

{shouldShowVideo && (
    <section class="report-video hero__individual">
        {autoplayUrl && (
            <iframe
                data-report-autoplay-src={autoplayUrl}
                title="Video del informe"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
            />
        )}
    </section>
)}

<script>
    const iframe = document.querySelector<HTMLIFrameElement>(
        "[data-report-autoplay-src]",
    );

    if (iframe) {
        const desktopMedia = window.matchMedia("(min-width: 48rem)");

        const updateAutoplay = () => {
            const videoUrl = iframe.dataset.reportAutoplaySrc;
            const hasVideoLoaded = iframe.dataset.loaded === "true";

            if (desktopMedia.matches && videoUrl && !hasVideoLoaded) {
                iframe.src = videoUrl;
                iframe.dataset.loaded = "true";
            }

            if (!desktopMedia.matches && hasVideoLoaded) {
                iframe.src = "about:blank";
                delete iframe.dataset.loaded;
            }
        };

        desktopMedia.addEventListener("change", updateAutoplay);
        updateAutoplay();
    }
</script>

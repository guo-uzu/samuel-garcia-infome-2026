---
interface Props {
	direction: 'prev' | 'next';
	label: string;
	class?: string;
}

const { direction, label, class: className } = Astro.props;
---

<button type="button" class:list={['arrow-btn', `arrow-btn--${direction}`, className]} aria-label={label}>
	<svg
		aria-hidden="true"
		width="20"
		height="20"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.5"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		{direction === 'prev' ? <path d="M15 18l-6-6 6-6" /> : <path d="M9 6l6 6-6 6" />}
	</svg>
</button>
---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ReportHero from "../../components/ReportHero.astro";
import ReportVideo from "../../components/ReportVideo.astro";
import Stat from "../../components/Stat.astro";
import Callout from "../../components/Callout.astro";
import Detail from "../../components/Detail.astro";

export async function getStaticPaths() {
    const reports = await getCollection("reports");
    return reports.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"reports">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
    <main id="contenido">
        <ReportVideo />
        <div class="container report">
            <ReportHero
                desktop={entry.data.imageDesktop}
                mobile={entry.data.imageMobile}
                alt={entry.data.imageAlt}
            />
            <header class="report__header">
                <p class="report__title" aria-hidden="true">
                    Lo nuevo sí cumple
                </p>
                <h1 class="report__topic">{entry.data.title}</h1>
            </header>
            <div class="report-prose">
                <Content components={{ Stat, Callout, Detail }} />
            </div>
            <div>Here should be the video</div>
            <div>
                <a href="/">Regresar a proyectos</a>
            </div>
        </div>
    </main>
</Layout>
